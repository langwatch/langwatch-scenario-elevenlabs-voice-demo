# ElevenLabs ConvAI (hosted agent) — required
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# OpenAI — required (powers the openai/nova voice user-simulator + the judge)
OPENAI_API_KEY=

# LangWatch — optional. Set it to stream simulation traces to the LangWatch cloud UI.
# The repro runs fine without it. (LANGWATCH_ENDPOINT / LANGWATCH_THREAD_ID also read if set.)
# LANGWATCH_API_KEY=

# --- Optional: logging / diagnostics ---
# SDK log verbosity — one of DEBUG | INFO | WARN | ERROR (case-insensitive; default INFO).
# LOG_LEVEL=debug
# Headless mode: "true" suppresses the live TUI and prints only final results.
# SCENARIO_HEADLESS=true
